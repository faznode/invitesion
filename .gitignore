/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.vscode

# Docker
postgres_data/
.env*.local
# runtime upload dir at repo root only — NOT lib/storage (source code)
/storage/

# clerk configuration (can include secrets)
/.clerk/

# research run (2026-10-29): private evidence, secret-scan reports, competitor thumbnails.
# No trailing slash so a symlink with this name is ignored too.
invitation-research/_private
# handoff archives are produced for download, never committed
/invitesion-handoff.zip
/invitesion-private.zip
# harness scratch output (snapshots/reports are regenerated by `check`)
tools/template-harness/.out/

# v0 sandbox internal files (the hosting sandbox may rewrite this file; keep everything above)
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.design-cache/
.v0-trash/
