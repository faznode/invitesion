# Copy to .env. It must be .env, not .env.local, without further config changes.
#
# Do NOT run `pnpm db:setup` to generate this — that script is a leftover from
# the nextjs/saas-starter template and will demand Stripe CLI and Docker that
# this project does not use. Copy this file by hand instead.

# ── Required ─────────────────────────────────────────────────
POSTGRES_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/vienne

# ── Clerk (auth) ─────────────────────────────────────────────
# Clerk owns credentials, sessions, password reset, email verification and
# social sign-in. The local `users` table stays the identity every domain table
# points at; a Clerk account is mapped onto it by `clerk_user_id`.
#
# Copy both from the Clerk dashboard → API keys. Use a Clerk instance dedicated
# to THIS project: keys from another app authenticate against that app's user
# pool, so its accounts would resolve to rows here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Routes. Kept explicit so Clerk never redirects to its own hosted pages —
# every step stays on our styled /sign-in and /sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# In the Clerk dashboard, enable "Name" under user & authentication so sign-up
# collects it — the profile page requires a name.
#
# ADMIN is NOT granted in Clerk. Set it on the database row by hand:
#   update users set role = 'ADMIN' where email = 'you@example.com';
# Keeping the privilege boundary in our own database means a misconfigured Clerk
# instance cannot mint an administrator.

# AUTH_SECRET is no longer used. It signed the local session JWT; Clerk owns
# sessions now. Safe to delete from your .env.

# Private admin route segment. Minimum 16 characters, random, never in public
# docs. Too short and the admin surface is disabled (logged), not the whole site.
ADMIN_ENTRY_PATH=replace-with-a-long-random-path

# ── Recommended ──────────────────────────────────────────────
# Absolute origin used to build guest links that leave the app (WhatsApp).
# Without it, links fall back to the forwarded request host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated allowlist of admin emails. Leave blank ONLY in local dev —
# blank means any account with role=ADMIN can reach the admin panel.
ADMIN_ALLOWED_EMAILS=owner@example.com

# ── Storage ──────────────────────────────────────────────────
# Two drivers. Local disk is the default and is correct for development and for
# a single long-lived server with a mounted volume. It is WRONG for serverless
# or multi-replica hosting: the filesystem is per-instance, so uploads vanish on
# redeploy and are invisible to other replicas.
#
# Local: where media is written. Defaults to <cwd>/storage/uploads, which
# follows the launch directory — set it explicitly anywhere that matters.
# Must be absolute, and must NOT live under public/.
# UPLOAD_ROOT=/var/lib/vienne/uploads
#
# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2). All four are
# required together; a partial config is a hard error rather than a silent
# fallback to local disk, which would lose uploads on the next deploy.
# S3_BUCKET=vienne-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Custom endpoint for non-AWS providers. R2: https://<account>.r2.cloudflarestorage.com
# S3_ENDPOINT=
# Path-style addressing (endpoint/bucket/key). Needed by MinIO and most
# self-hosted gateways; AWS and R2 prefer virtual-host style.
# S3_FORCE_PATH_STYLE=false
# S3_SESSION_TOKEN=
#
# The jobs runner (services/api `invitesion-jobs`: image variants, B-031's purge)
# reads the same variables. The purge lists and deletes objects under an
# invitation's own prefixes (<id>/, variants/<id>/, protected/<id>/), so its
# credentials also need list and delete on the bucket (s3:ListBucket,
# s3:DeleteObject); without them purges keep retrying with their error.

# ── Payment ──────────────────────────────────────────────────
# Two rails, chosen by the order's currency, never by geolocation:
#   IDR  -> QRIS   (local)
#   else -> Stripe (international)
# The currency the customer is quoted decides the rail, so the price shown and
# the way it is charged can never disagree.

# --- QRIS (local) ---
# QRIS is a STANDARD, not a payment company. Issuing a QR needs only your own
# merchant string; receiving an automatic settlement callback needs an acquirer
# (Xendit, DOKU, Flip, Midtrans, a bank). Until one is signed, use "manual":
# the QR carries the exact amount and an admin confirms payment in the panel.
QRIS_ACQUIRER=manual
# The raw EMVCo text behind your merchant QR image — not the image, not a URL.
# Decode your printed QRIS with any QR reader and paste the whole string.
# Its checksum is verified on startup, so a truncated paste fails immediately
# rather than in a customer's banking app.
QRIS_STATIC_PAYLOAD=

# --- Stripe (international) ---
# Both are required together. Without the webhook secret the rail refuses to
# start: we could otherwise take money and never verify that we had.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Point the Stripe dashboard webhook at:  POST /api/payments/stripe/webhook
# Local testing:  stripe listen --forward-to localhost:3000/api/payments/stripe/webhook

# ── Rust domain API (R-01, ADR-A2) ───────────────────────────
# Server-side only: Next.js signs every call to services/api; browsers never
# reach it. Each migrated data domain has exactly one writer, chosen with
# BACKEND_<DOMAIN>=next|rust (default next, with no fallback between them);
# setting it back to next is the rollback. Needed only once a domain is on rust.
# API_BASE_URL=https://api.example.invalid
# INTERNAL_API_SECRET=      # at least 32 characters; the same value on the API
# BACKEND_VIEWS=next        # R-02: invitation opens (analytics VIEW rows)
# BACKEND_RSVP=next         # R-03: guest RSVPs and host overrides (needs OWNER_TOKEN_* on the API)
# BACKEND_WISHES=next       # R-04: guest wishes, host moderation and replies (needs OWNER_TOKEN_* on the API)
# BACKEND_ROSTER=next       # B-033: guest lists, imports, self-registration and decisions (needs OWNER_TOKEN_* on the API)
# BACKEND_CONTENT=next      # B-035 / B-037: the editor's saves (version-checked) and draft creation (row + version 1, keyed); needs OWNER_TOKEN_* on the API
# BACKEND_PAYMENT=next      # B-039: settlement (webhooks and the administrator's confirmation): event, order, payment, activation, outbox row; deploy invitesion-jobs with it
# Self-registrations per invitation link and per address, as <count>/<seconds>; both writers read the same values,
# so set them identically here and on the API.
# RATE_LIMIT_REGISTRATION_LINK=20/600
# RATE_LIMIT_REGISTRATION_IP=5/600
# The API's own variables are listed in services/api/README.md.
#
# Reverse proxies in front of Next.js that append to X-Forwarded-For; the RSVP
# per-address limit reads the entry the outermost one wrote. On Vercel keep 1
# (the default): its edge replaces the header with the client's address alone.
# Self-hosted behind proxies that append (nginx, a load balancer), count each
# one. 0 trusts no header (only the per-link limit applies).
# TRUSTED_PROXY_HOPS=1

# ── Guest pass and check-in (B-024, D-056) ───────────────────
# Signs each guest's QR pass: at least 32 bytes, used as written (for example
# `openssl rand -base64 48`). With BACKEND_ROSTER=rust the API needs the same
# value. To rotate, move the old value to _PREVIOUS so passes already sent still
# scan, and drop it once those events are over. Without a secret no pass is
# shown and the check-in route answers 503. The feature is FLAG_GUEST_PASS
# (default off) plus each invitation's own opt-in.
# GUEST_PASS_SECRET=
# GUEST_PASS_SECRET_PREVIOUS=
# Scanner batches per host and invitation, as <count>/<seconds>.
# RATE_LIMIT_CHECKIN=120/60

# G-044 (D-057): an invitation's team. On, an owner can invite co-hosts (guests,
# wishes, insights and the check-in desk) and ushers (the desk only) by one-time
# links. Off (the default) is owner-only everywhere; stored grants are kept and
# work again when it is switched back on. Needs migration 0023.
# FLAG_TEAM_ACCESS=off

# G-045 (D-058): the owner's day-of logs (seating tables and seats, souvenirs
# handed out, a private gift log) with CSV exports, owner-only. Off (the default)
# answers 404 on the page, its actions and exports, and the manage centre shows
# seating as before; stored rows are kept. Needs migrations 0024 and 0025 (I-04:
# a gift's family side on a wedding, D-059).
# FLAG_HOST_LOGS=off

# I-22 (D-060): the wishes book, a PDF of the invitation's visible wishes (oldest
# first, with the host's replies) that the owner downloads from the wishes page.
# Owner only; made on request, nothing stored. Off (the default) hides the
# download and the route answers 404. Needs no migration.
# FLAG_WISHES_BOOK=off

# G-050: the owner's receipts (/dashboard/receipts, a printable page each) and the
# link from a paid checkout. The jobs runner (B-039 outbox) issues a receipt for
# every new payment whatever this says; earlier payments get theirs on request.
# Needs migration 0028 and the jobs runner. Off (the default) hides the pages,
# the request and the link (404); issued receipts are kept.
# FLAG_RECEIPTS=off

# ── Coupons (G-053, D-066) ───────────────────────────────────
# Administrators create coupons in the console (/admin/<entry>/coupons), always
# inactive until activated there. On shows the checkout's coupon field; the
# discount is computed on the server and recorded on the order. Needs migration
# 0029. Off (the default) hides the field and refuses a typed code with a notice;
# orders already made keep their discounted amount.
# FLAG_COUPONS=off

# ── Reseller workspaces (G-052, D-067) ───────────────────────
# A customer creates one workspace at /dashboard/workspace, makes their own
# invitations client invitations and invites staff by one-time links
# (/gabung/ruang/<secret>): a manager (guests, wishes, insights, the desk) or a
# desk (check-in only). Needs migration 0030 (after 0029). Off (the default):
# the workspace and join pages answer 404 and staff hold nothing; workspaces,
# memberships, assignments and the credit ledger are kept.
# FLAG_WORKSPACES=off

# ── Invitation deletion and retention (B-031, D-063) ─────────
# The owner deletes an invitation from its card: guests, links, passes, the
# public uploads and every writer lose it at once (404, as if it never existed),
# the owner may restore it during the window, then the jobs runner's
# `invitation_purge` removes its data. Payment records are kept. Needs migration
# 0026 and the jobs runner with the same database and storage.
# No duration is approved: both are owner and counsel decisions (UU PDP review).
# Leave them unset until approved; there is deliberately no default.
# FLAG_INVITATION_DELETION=off
# Days between a deletion and its purge (1-3650), read by Next.js and the jobs
# runner. Unset: deletion is unavailable even with the flag on. Restoring an
# invitation already deleted stays available whatever the flag says.
# INVITATION_DELETION_WINDOW_DAYS=
# Days after an invitation's active period ends before the jobs runner deletes
# it as its owner would, opening the same window (0-3650). Runs only when
# INVITATION_DELETION_WINDOW_DAYS is set too; unset, nothing expires on its own.
# INVITATION_RETENTION_DAYS_AFTER_EXPIRY=
# Rollback: flag off hides deletion; unsetting either duration stops the sweep.
# Neither undoes a purge (recovery is a backup restore, an owner operation).

# ── Content-Security-Policy (B-038, D-061) ───────────────────
# Every page is sent a per-request nonce policy (lib/security/csp.ts). Unset, it
# is report-only everywhere: browsers post violations to /api/csp-report, which
# logs one minimized `[csp-report]` line each (no page address, slug or sample).
# `guest` enforces it on guest pages (/i/...) and keeps it report-only elsewhere;
# `true` enforces it everywhere. Go one step only after a report-only period with
# no unexplained `[csp-report]` lines. Rollback: unset it.
# CSP_ENFORCE=guest

# ── Optional ─────────────────────────────────────────────────

# Postgres connections per instance. Budget against the database's
# max_connections divided by the number of running instances.
# POSTGRES_POOL_MAX=10
