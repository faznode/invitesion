{
  "openapi": "3.1.0",
  "info": {
    "title": "Invitesion API",
    "description": "Domain API (ADR-A2). Server-to-server only: every operation except liveness requires the internal service signature.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/guest-links/{slug}/{guest}/rsvp": {
      "post": {
        "tags": [
          "rsvp"
        ],
        "operationId": "guest_rsvp",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "The invitation's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "guest",
            "in": "path",
            "description": "The last segment of the guest's personal link: an opaque token, or the slug of a guest without one (B-011)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "1–255 visible ASCII characters; a retry with the same key and request replays the committed answer for 24 hours",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestRsvpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Saved, or replayed (`Idempotent-Replayed: true`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsvpSaved"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body or idempotency key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service signature",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No published invitation, or no guest for this link (`rsvp.link_not_found`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "RSVP is closed (`rsvp.closed`; detail `disabled`, `deadline` or `expired`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Refused by the rules: `rsvp.status_invalid`, `rsvp.event_answer_missing` (`eventId`), `rsvp.answer_invalid` (`questionId`), or `idempotency.key_reused`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many RSVP writes for this link or address (`rate_limit.exceeded`); nothing was written",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Seconds until the limit's window ends"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceSignature": []
          }
        ]
      }
    },
    "/v1/guest-links/{slug}/{guest}/wishes": {
      "post": {
        "tags": [
          "wishes"
        ],
        "operationId": "guest_wish",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "The invitation's slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "guest",
            "in": "path",
            "description": "The last segment of the guest's personal link: an opaque token, or the slug of a guest without one (B-011)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "1–255 visible ASCII characters; a retry with the same key and message replays the stored wish for 24 hours",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestWishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored, or replayed (`Idempotent-Replayed: true`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WishSaved"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body or idempotency key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service signature",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No published invitation, or no guest for this link (`wish.link_not_found`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The guestbook is closed (`wish.closed`; detail `disabled` or `expired`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "An empty or too long message (`wish.message_invalid`), or `idempotency.key_reused`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many wishes for this link or address (`rate_limit.exceeded`); nothing was written",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Seconds until the limit's window ends"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceSignature": []
          }
        ]
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process answers. Touches nothing else, so probes stay cheap and reveal nothing.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The process answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: the database answers a trivial query.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "The database answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid service signature",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceSignature": []
          }
        ]
      }
    },
    "/v1/invitations/{invitation}/guests/{guest}/rsvp-override": {
      "post": {
        "tags": [
          "rsvp"
        ],
        "operationId": "host_rsvp_override",
        "parameters": [
          {
            "name": "invitation",
            "in": "path",
            "description": "The owner's invitation",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          },
          {
            "name": "guest",
            "in": "path",
            "description": "A guest of that invitation",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "As for the guest RSVP",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HostRsvpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Saved, or replayed (`Idempotent-Replayed: true`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsvpSaved"
                }
              }
            }
          },
          "400": {
            "description": "Malformed path, body or idempotency key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid signature or owner token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "A token for no live customer (`owner.unknown_user`, `owner.role_not_allowed`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not this owner's invitation, or not its guest (`invitation_or_guest.not_found`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "An event the guest is not asked about, or an event answer without per-event RSVP (`rsvp.override_invalid`); `idempotency.key_reused`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Owner tokens are not configured or the signing keys are unreachable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "ownerToken": [],
            "serviceSignature": []
          }
        ]
      }
    },
