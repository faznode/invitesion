  "components": {
    "schemas": {
      "EventFields": {
        "type": "object",
        "description": "One event's fields: `ev:<id>` and `evn:<id>`.",
        "properties": {
          "status": {
            "type": "string"
          },
          "guestCount": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "GuestRsvpRequest": {
        "type": "object",
        "description": "A guest's RSVP as the form submitted it.",
        "required": [
          "submission",
          "flags"
        ],
        "properties": {
          "submission": {
            "$ref": "#/components/schemas/RsvpSubmission"
          },
          "flags": {
            "$ref": "#/components/schemas/RsvpFlags"
          },
          "clientIp": {
            "type": [
              "string",
              "null"
            ],
            "description": "The guest's public address as Next.js's trusted proxies reported it (`TRUSTED_PROXY_HOPS`). Used only for the\nper-address limit: an IPv4 address, or the /64 of an IPv6 address, reduced to a keyed hash and never stored or\nlogged. Absent or not an IP literal = no per-address limit (the per-link limit still applies)."
          }
        },
        "additionalProperties": false
      },
      "GuestWishRequest": {
        "type": "object",
        "description": "A guest's wish as the form submitted it.",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "As typed; trimmed and judged by the rules (1 to 1,000 UTF-16 units after trimming)."
          },
          "clientIp": {
            "type": [
              "string",
              "null"
            ],
            "description": "The guest's public address as Next.js's trusted proxies reported it (`TRUSTED_PROXY_HOPS`), for the per-address\nlimit only: reduced to a keyed hash, never stored or logged. Absent or not an IP literal = no per-address limit."
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` when the process answers."
          },
          "version": {
            "type": "string",
            "description": "Crate version of the running build."
          }
        }
      },
      "HostRsvpFlags": {
        "type": "object",
        "required": [
          "perEvent",
          "inviteOnlyEvents"
        ],
        "properties": {
          "perEvent": {
            "type": "boolean",
            "description": "`RSVP_PER_EVENT`."
          },
          "inviteOnlyEvents": {
            "type": "boolean",
            "description": "`INVITE_ONLY_EVENTS`."
          }
        },
        "additionalProperties": false
      },
      "HostRsvpRequest": {
        "type": "object",
        "description": "A host sets one guest's answer: for the whole invitation, or for one event (`eventId`).",
        "required": [
          "status",
          "flags"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HostRsvpStatus"
          },
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "flags": {
            "$ref": "#/components/schemas/HostRsvpFlags"
          }
        },
        "additionalProperties": false
      },
      "HostRsvpStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "CONFIRMED",
          "DECLINED",
          "MAYBE"
        ]
      },
      "Me": {
        "type": "object",
        "description": "The caller as this application knows it.",
        "required": [
          "userId",
          "role"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "role": {
            "type": "string",
            "description": "`CUSTOMER` or `ADMIN`, from `users.role`."
          }
        }
      },
      "ModeratedState": {
        "type": "string",
        "enum": [
          "VISIBLE",
          "HIDDEN",
          "DELETED"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "An error response. `code` is stable and machine-readable; `title` and `detail` are for people and may change.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "`https://invitesion.id/problems/<code>`."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "code": {
            "type": "string",
            "description": "Stable machine code, `domain.reason`."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The event a `rsvp.event_answer_missing` problem is about."
          },
          "questionId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question a `rsvp.answer_invalid` problem is about."
          }
        }
      },
      "RecordView": {
        "type": "object",
        "description": "One open of an invitation page.",
        "required": [
          "invitationId"
        ],
        "properties": {
          "invitationId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "guestId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The guest of a personal link; absent for an anonymous open.",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "RsvpFlags": {
        "type": "object",
        "description": "The switches the guest page was rendered with (`lib/flags.ts`); Next.js sends the values it renders with.",
        "required": [
          "maybe",
          "perEvent",
          "inviteOnlyEvents",
          "questions"
        ],
        "properties": {
          "maybe": {
            "type": "boolean",
            "description": "`RSVP_MAYBE`: guests may answer \"mungkin\"."
          },
          "perEvent": {
            "type": "boolean",
            "description": "`RSVP_PER_EVENT`: an answer per event once the host switches it on for two or more events."
          },
          "inviteOnlyEvents": {
            "type": "boolean",
            "description": "`INVITE_ONLY_EVENTS`: invite-only events are shown and asked only to the guests invited to them."
          },
          "questions": {
            "type": "boolean",
            "description": "`RSVP_QUESTIONS`: the host's custom questions."
          }
        },
        "additionalProperties": false
      },
      "RsvpSaved": {
        "type": "object",
        "description": "The guest's answer after the write.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`CONFIRMED`, `DECLINED`, `MAYBE`, or `PENDING` after a host clears an answer."
          },
          "attendingCount": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "People attending: 0 for a decline, null while unknown."
          }
        }
      },
      "RsvpSubmission": {
        "type": "object",
        "description": "What the guest's form submitted, independent of HTML field names (`RsvpSubmission`).",
        "properties": {
          "status": {
            "type": "string",
            "description": "The single answer as typed: `CONFIRMED`, `DECLINED`, `MAYBE` or anything else (refused)."
          },
          "guestCount": {
            "type": [
              "string",
              "null"
            ],
            "description": "The headcount field as typed; absent and empty both mean one person."
          },
          "events": {
            "type": "object",
            "description": "Per-event answers by event id.",
            "additionalProperties": {
              "$ref": "#/components/schemas/EventFields"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "answers": {
            "type": "object",
            "description": "Every submitted value of each question, by question id.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "propertyNames": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "ViewRecorded": {
        "type": "object",
        "required": [
          "recorded"
        ],
        "properties": {
          "recorded": {
            "type": "boolean",
            "description": "False when the open fell inside the dedupe window of an earlier one."
          }
        }
      },
      "WishAction": {
        "type": "string",
        "enum": [
          "SHOW",
          "HIDE",
          "DELETE"
        ]
      },
      "WishModerated": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "state": {
            "$ref": "#/components/schemas/ModeratedState"
          }
        }
      },
      "WishModerationRequest": {
        "type": "object",
        "description": "The host shows, hides or deletes one wish.",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/WishAction"
          }
        },
        "additionalProperties": false
      },
      "WishReplied": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "hostReply": {
            "type": [
              "string",
              "null"
            ],
            "description": "The stored reply, trimmed; null after clearing."
          }
        }
      },
      "WishReplyRequest": {
        "type": "object",
        "description": "The host's reply to one wish; an empty or blank reply clears it.",
        "required": [
          "reply"
        ],
        "properties": {
          "reply": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "WishSaved": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "state": {
            "$ref": "#/components/schemas/WishState",
            "description": "`VISIBLE`, or `PENDING` while the guestbook is moderated."
          }
        }
      },
      "WishState": {
        "type": "string",
        "description": "A wish as the guest page and the host see it.",
        "enum": [
          "VISIBLE",
          "PENDING",
          "HIDDEN"
        ]
      }
    },
    "securitySchemes": {
      "ownerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-invitesion-signature",
        "description": "t=<unix seconds>,v1=<hex HMAC-SHA256 of t.METHOD.path_and_query.sha256hex(body)>"
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness"
    },
    {
      "name": "identity",
      "description": "Owner-token verification"
    },
    {
      "name": "views",
      "description": "Invitation opens (R-02)"
    },
    {
      "name": "rsvp",
      "description": "Guest RSVP and the host's override (R-03)"
    },
    {
      "name": "wishes",
      "description": "Guest wishes and the host's moderation and replies (R-04)"
    }
  ]
}
