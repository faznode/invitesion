  "query": "select g.invited_event_ids, i.config from guests g join invitations i on i.id = g.invitation_id where g.id = $1 and g.invitation_id = $2 and (i.user_id = $3 or exists (select 1 from invitation_members m where m.invitation_id = i.id and m.user_id = $3 and m.revoked_at is null and m.role = any($4))) for update of g",
